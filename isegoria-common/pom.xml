<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ruwei</groupId>
        <artifactId>isegoria-cloud</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>isegoria-common</artifactId>
    <name>isegoria-common</name>
    <dependencies>
        <!-- ================= core：响应/错误码/分页/异常（零业务依赖） ================= -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ================= web：全局异常 / CORS / Jackson(Long→String) / @RateLimit ================= -->
        <!-- GlobalExceptionHandler 捕获 Sa-Token 异常、RateLimitAspect 调 StpUtil 取登录态 -->
        <!-- Sa-Token（1.41.0，版本由父 POM 的 sa-token BOM 管理）：
             starter = core + 自动装配 + 拦截器能力；redis-jackson = 会话存 Redis。
             六服务连同一 Redis 且 sa-token 配置逐字一致 → 登录态跨服务共享，登录代码零改造 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- @RateLimit 切面（@Aspect） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- RateLimitAspect 的 Redis Lua 限流 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ruwei</groupId>
            <artifactId>isegoria-model</artifactId>
        </dependency>

        <!-- ================= mybatis：分页插件 / CountUtils ================= -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- MP 分页必须显式依赖（starter 未传递该模块） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser-4.9</artifactId>
        </dependency>
    </dependencies>
</project>
